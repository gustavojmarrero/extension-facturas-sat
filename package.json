{
  "name": "extension-facturas-sat",
  "version": "1.0.0",
  "private": true,
  "description": "Extensión de Chrome de Reporte Ágil: relación de facturas del portal del SAT a Excel, XML y PDF, en el navegador.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "zip": "node scripts/build.mjs --zip",
    "test": "node --test test/*.test.js",
    "test:e2e": "node scripts/build.mjs --pruebas && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.2"
  }
}
